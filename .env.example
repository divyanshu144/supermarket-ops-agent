DATABASE_URL=postgres://kirana:kirana@localhost:5432/kirana
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-only-change-me
# Optional separate reader account for Neo4j editions with database roles.
# Community Edition uses the same account; application reads still use READ-mode sessions.
# NEO4J_READER_USERNAME=neo4j_reader
# NEO4J_READER_PASSWORD=replace-with-reader-password
# NEO4J_DATABASE=neo4j
# Required only when running the resumable source-history backfill. Choose a durable path.
# GRAPH_BACKFILL_STATE_FILE=/data/neo4j-backfill-state.json
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Voice note transcription (Whisper). Leave unset to disable voice input — the bot still
# boots and serves text normally without it.
OPENAI_API_KEY=
# Optional hosted open-weight voice transcript helper. Disabled by default.
TIERING_ENABLED=false
TIERING_BASE_URL=
TIERING_API_KEY=
TIERING_MODEL=
TIERING_TIMEOUT_MS=4000
TIERING_MIN_CONFIDENCE=0.9
# Optional Langfuse Cloud tracing. Tracing is disabled unless all three values are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Content remains omitted unless explicitly enabled; identifiers, phone numbers and amounts are masked.
LANGFUSE_CAPTURE_CONTENT=false
AGENT_EFFORT=medium
NODE_ENV=development

# Log inbound message text. Defaults on in development, off in production.
LOG_MESSAGE_TEXT=false

# Optional privacy contact shown by /privacy. Use a Telegram username or email address.
# PRIVACY_CONTACT=@your_privacy_contact

# App-owned transcript and generated artifact retention, measured from last activity.
# The proposed default is 30 days. This does not control provider-side retention.
APP_DATA_RETENTION_DAYS=30

# Agent limits and cost controls. Defaults shown; uncomment to override.
# AGENT_MODEL=claude-opus-5
# AGENT_FALLBACK_MODEL=
# AGENT_MAX_TURNS=15
# AGENT_MAX_BUDGET_USD=0.5
# AGENT_TURN_TIMEOUT_MS=90000
# STORE_DAILY_BUDGET_USD=5
# RATE_LIMIT_TURNS=20
# RATE_LIMIT_WINDOW_S=600
# SHUTDOWN_GRACE_MS=30000
